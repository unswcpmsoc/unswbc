{
    "name": "battledragon-replay-viewer",
    "displayName": "Battledragon Replay Viewer",
    "description": "Open .replay files in an interactive board viewer.",
    "version": "1.0.2",
    "publisher": "unswbc",
    "private": true,
    "type": "module",
    "engines": { "vscode": "^1.90.0" },
    "categories": ["Visualization"],
    "main": "./dist/extension.cjs",
    "capabilities": {
        "untrustedWorkspaces": { "supported": true }
    },
    "contributes": {
        "customEditors": [
            {
                "viewType": "battledragon.replayViewer",
                "displayName": "Battledragon Replay",
                "selector": [{ "filenamePattern": "*.replay" }],
                "priority": "default"
            }
        ]
    },
    "scripts": {
        "build": "vite build && node build.mjs",
        "check": "svelte-check --tsconfig ./tsconfig.json",
        "watch": "vite build --watch",
        "package": "vsce package --no-dependencies --allow-missing-repository"
    },
    "dependencies": {
        "@lucide/svelte": "^1.47.0",
        "capnp-es": "^0.0.16"
    },
    "devDependencies": {
        "@sveltejs/vite-plugin-svelte": "^7.0.0",
        "@vscode/vsce": "^3.6.0",
        "@types/vscode": "^1.90.0",
        "esbuild": "^0.28.0",
        "svelte": "^5.55.2",
        "svelte-check": "^4.4.6",
        "typescript": "^5.9.0",
        "vite": "^8.0.7"
    },
    "pnpm": { "onlyBuiltDependencies": ["esbuild"] }
}
